# variables
variable t_total equal 100000
variable origin_spacing equal 10000
variable maxTau equal 10000
variable equil equal 10000
variable name string eps1mu2
variable eps string eps1
variable mu equal 2.0
variable phi equal 0.2

# calculate number density for given phi
variable rho equal (6.0/3.14159)*v_phi   # assumes sigma = 1


units lj
atom_style hybrid dipole sphere

lattice sc ${rho}


region box1 block 0 15 0 15 0 15
create_box 1 box1
create_atoms 1 region box1

set group all mass 1.0



timestep 0.000500

# dipole settings
set group all charge 0.0
set group all dipole 0.0 0.0 ${mu}
pair_style hybrid/overlay table spline 11000 ewald lj/cut/dipole/long 0 5

# colloid settings
pair_coeff * * table ${eps}.table colloid 5
pair_coeff * * lj/cut/dipole/long 0.0 1.0

kspace_style ewald/dipole 1.0E-3
neighbor 0.3 bin
neigh_modify delay 0 every 100 check no

minimize 1.0e-4 1.0e-6 100 15000
velocity all create 1.0 4928459 dist gaussian
fix 1 all nvt temp 1.0 1.0 0.1

# Equilibration
run 10000

# thermo data settings
thermo_style custom step temp epair etotal press 

    # This command specifies what thermodynamic quantities we want as output
    # step = the current step
    # temp = temperature
    # epair = pairwise potential energy
    # etotal = total energy
    # press = pressure
    # density = density

variable s equal step
variable t equal temp
variable e equal epair 
variable et equal etotal
variable p equal press
fix thermo_out all print 10 "${s} ${t} ${e} ${et} ${p}" file thermo_output.txt screen no


# Production with multiple time origins
variable nOrigins equal ${t_total}/${origin_spacing}
variable i loop ${nOrigins}

label loop_origin

variable t0snap equal (${i}-1)*${origin_spacing}

# Open dump with huge interval so it never fires mid-run
dump d all custom 99999999 ${name}.configs/dump.${t0snap}.lammpstrj id type xu yu zu

# tau = 0 snapshot
dump_modify d every 1
run 0

# ---- log sampling ----
variable tau equal 1
variable elapsed equal 0

label logloop

variable remainingTau equal ${maxTau}-${elapsed}
variable thisstep equal ${tau}
if "${thisstep} > ${remainingTau}" then "variable thisstep equal ${remainingTau}"

# Advance — dump suppressed by huge interval
dump_modify d every 99999999
run ${thisstep}

# Snapshot at this tau
dump_modify d append yes every 1
run 0

variable elapsed equal ${elapsed}+${thisstep}
variable tau equal ${tau}*2

if "${elapsed} < ${maxTau}" then "jump SELF logloop"

undump d

# ---- go EXACTLY to next origin ----
variable next_origin equal ${t0snap}+${origin_spacing}
variable remaining equal ${next_origin}-step
if "${remaining} > 0" then "run ${remaining}"

next i
jump SELF loop_origin